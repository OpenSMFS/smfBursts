subgraph cluster_0{
    label="PhotonDataSet"
    PhotonData;
}
  
subgraph cluster_1{
  label="Base Table"
  Base
  Periods
  Bursts
}

subgraph cluster_2{
  label="ChildTable"
  BG
  NPH
  Ratios
}

Base->Periods[arrowhead=none label="contributes columns"];
Base->Bursts[arrowhead=none label="contributes columns"];

PhotonData -> Periods:top;
Periods:out -> BG:base [label="defines rows"];
BG:out->Bursts:bg;
Bursts:out->NPH:base [label="defines rows"];
BG:out->NPH:bg;
NPH:out->Ratios:nph;
Bursts:out->Ratios [style="dotted" label="defines rows (through NphBG:bg)"];
}
