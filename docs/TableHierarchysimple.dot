digraph {
  rankdir=TB;
  compound=true
  DataSet [group=1 label="DataSet\n(any raw data)" shape=folder];
  PhotonData[group=1 shape=folder label="PhotonData\nMust store:\n  - times\n  - dets"];
  BaseTable[gruop=2 shape=tab label="BaseTable\n- Defines rows"];
  ChildTable[group=3 shape=tab label="ChildTable\n- inherets rows of BaseTable"];
  BasePhotonTable[group=2, shape=tab label="BasePhotonTable\n- Rows define time ranges in PhotonData"];
  ChildPhotonTable[group=3 shape=tab label="ChildPhotonData\n- Rows defined by BasePhotonTable"];
  PhotonTable[group=4 shape=rect label="PhotonTable\n- Origin must be PhotonData\n- Normalizes PhSel"]
  Periods[group=2 shape=tab label="Periods\n- Divide PhotonData into even time segments"];
  Bursts[group=2 shape=tab label="Bursts\n- Main burst search\n- logical operation on n sliding window burst searches"];
  BG[group=3 shape=tab label="BG\n- per period per channel background\n- can map to any BasePhotonTable"];
  NphBG[group=3 shape=tab label="NphBG\n- background corrected channel intensities"];
  Ratios[group=3 shape=tab label="Ratios\n- Cross-talk matrix corrects channel intensities\n- Primarily for fully corrected E/S values"];

  subgraph cluster_1 {
    label = "BasePhotonTables"
    Periods -> Bursts [style=invis];
  }
  subgraph cluster_2 {
    label = "ChildPhotonTables"
    BG -> NphBG [style=dashed];
    {rank=same NphBG -> Ratios[style=dashed]}
  }
  {rank=same DataSet -> BaseTable -> ChildTable [style=invis]}
  {rank=same PhotonData -> BasePhotonTable -> ChildPhotonTable [style=invis]}
  DataSet -> PhotonData;
  BaseTable -> BasePhotonTable;
  ChildTable -> ChildPhotonTable;
  PhotonData -> BasePhotonTable [style=invis]
  BasePhotonTable -> Periods [lhead="cluster_1"];
  ChildPhotonTable -> BG [lhead="cluster_2"];
  {rank=same BasePhotonTable; ChildPhotonTable}
  PhotonTable -> BasePhotonTable;
  PhotonTable -> ChildPhotonTable;
  Periods -> BG [style=dashed];
  BG -> Bursts [style=dashed];
  BasePhotonTable -> NphBG [style=dashed];
  Bursts -> NphBG [style=dotted];
  PhotonData -> Periods [lhead=cluster_1];
}

